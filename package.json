{
  "name": "terasuma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TERASUMA_DEV=1 bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "start:dist": "cd dist && bun index.js",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "test:live": "bun test ./tests/live/*.live.ts",
    "typecheck": "bunx tsc --noEmit",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "check": "bun run typecheck && biome check . && bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.84",
    "@ai-sdk/cerebras": "^3.0.74",
    "@ai-sdk/deepinfra": "^3.0.74",
    "@ai-sdk/google": "^4.0.101",
    "@ai-sdk/groq": "^4.0.66",
    "@ai-sdk/mistral": "^4.0.68",
    "@ai-sdk/openai": "^4.0.98",
    "@ai-sdk/openai-compatible": "^3.0.74",
    "@ai-sdk/perplexity": "^5.0.16",
    "@ai-sdk/togetherai": "^3.0.75",
    "@ai-sdk/xai": "^5.0.26",
    "@modelcontextprotocol/client": "2.2.0",
    "@novnc/novnc": "1.7.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@preact/signals": "^2.11.3",
    "@tabler/icons-preact": "^3.49.0",
    "ai": "^7.0.146",
    "preact": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/server": "2.2.0",
    "@types/bun": "^1.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
