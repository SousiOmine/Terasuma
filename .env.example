# ── LLM ────────────────────────────────────────────────
# Mastra のモデルルーター形式 "provider/model" で指定する。
# 例: deepseek/deepseek-flash, openai/gpt-5.6-sol, anthropic/claude-sonnet-4-6
TERASUMA_MODEL=deepseek/deepseek-flash

# 使うプロバイダの API キーを入れる（Mastra がプロバイダごとの変数を読む）
DEEPSEEK_API_KEY=

# OpenAI 互換の独自エンドポイントを使う場合のみ設定する
# TERASUMA_BASE_URL=
# TERASUMA_API_KEY=

# ── サーバ ─────────────────────────────────────────────
TERASUMA_PORT=3000
# TERASUMA_DATA_DIR=        # 既定: ~/.terasuma

# ── 開発用 ─────────────────────────────────────────────
# モックの LLM で UI とストリーミングだけを確認する（API キー不要）
# TERASUMA_ENGINE=mock
